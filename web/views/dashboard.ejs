

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Badge Bot</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="dashboard">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo-small">🏆</div>
        <h2>Badge Bot</h2>
      </div>
      
      <nav class="sidebar-nav">
        <a href="#badges" class="nav-item active" data-tab="badges">
          <span class="nav-icon">🎖️</span>
          <span>Badges</span>
        </a>
        <a href="#categories" class="nav-item" data-tab="categories">
          <span class="nav-icon">📁</span>
          <span>Categories</span>
        </a>
      </nav>
      
      <div class="sidebar-footer">
        <div class="user-profile">
          <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar">
          <div class="user-info">
            <span class="username"><%= user.username %></span>
            <span class="user-role">Staff</span>
          </div>
        </div>
        <a href="/logout" class="btn-logout">Logout</a>
      </div>
      
      <div class="developer-credit-sidebar">
  The Baddies Bookshelf • Badge Archive
</div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <!-- Badges Tab -->
      <div id="badges-tab" class="tab-content active">
        <div class="content-header">
          <h1>Badges Management</h1>
          <button class="btn btn-primary" onclick="openBadgeModal()">
            <span>+</span> Create Badge
          </button>
        </div>
        
        <div class="search-bar">
          <input type="text" id="badge-search" placeholder="🔍 Search badges..." onkeyup="filterBadges()">
        </div>
        
        <div id="badges-grid" class="cards-grid">
          <!-- Badges will be loaded here -->
        </div>
      </div>

      <!-- Categories Tab -->
      <div id="categories-tab" class="tab-content">
        <div class="content-header">
          <h1>Categories Management</h1>
          <button class="btn btn-primary" onclick="openCategoryModal()">
            <span>+</span> Create Category
          </button>
        </div>
        
        <div id="categories-list" class="categories-container">
          <!-- Categories will be loaded here -->
        </div>
      </div>
    </main>
  </div>

  <!-- Badge Modal -->
  <div id="badge-modal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="badge-modal-title">Create Badge</h2>
        <button class="close-btn" onclick="closeBadgeModal()">&times;</button>
      </div>
      <form id="badge-form" enctype="multipart/form-data">
        <input type="hidden" id="badge-id">
        
        <div class="form-group">
          <label for="badge-name">Badge Name *</label>
          <input type="text" id="badge-name" required placeholder="Enter badge name">
        </div>
        
        <div class="form-group">
          <label for="badge-description">Description *</label>
          <textarea id="badge-description" required placeholder="Enter badge description" rows="3"></textarea>
        </div>
        
        <div class="form-group">
          <label for="badge-category">Category *</label>
          <select id="badge-category" required>
            <option value="">Select category</option>
          </select>
        </div>
        
        <div class="form-group">
          <label for="badge-image">Badge Image *</label>
          <div class="file-upload">
            <input type="file" id="badge-image" accept="image/*" onchange="previewImage(event)">
            <label for="badge-image" class="file-upload-label">
              <span class="upload-icon">📤</span>
              <span id="file-name">Choose an image</span>
            </label>
          </div>
          <div id="image-preview" class="image-preview"></div>
        </div>
        
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="closeBadgeModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <span id="badge-submit-text">Create Badge</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Category Modal -->
  <div id="category-modal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Create Category</h2>
        <button class="close-btn" onclick="closeCategoryModal()">&times;</button>
      </div>
      <form id="category-form">
        <div class="form-group">
          <label for="category-name">Category Name *</label>
          <input type="text" id="category-name" required placeholder="Enter category name">
        </div>
        
        <div class="form-group">
          <label for="category-description">Description</label>
          <textarea id="category-description" placeholder="Enter category description (optional)" rows="2"></textarea>
        </div>
        
        <div class="form-group">
          <label for="category-emoji">Emoji</label>
          <input type="text" id="category-emoji" placeholder="🏆" maxlength="2">
        </div>
        
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="closeCategoryModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Category</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast" class="toast"></div>

  <script src="/js/dashboard.js"></script>
</body>
</html>

